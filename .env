# cloud url: https://api.considition.com/api/
API_BASE=http://localhost:8080
API_KEY=YOUR-API-KEY
MAP_NAME=Batterytown
USE_PLAY_TO_TICK=false
PLAY_TO_TICK=

POLICY_AUTOTRAIN=true
POLICY_DATA_CSV=./data/charging_events.csv
POLICY_OUTDIR=./model_artifacts
POLICY_FORCE_RETRAIN=true
POLICY_ALPHA=1
# Policy beta trade satisfaction for electric power
POLICY_BETA=1.5
POLICY_GAMMA=0.03
POLICY_N_EST=600
POLICY_MAX_DEPTH=6
POLICY_LR=0.05
POLICY_CHARGE_BIAS=0.09